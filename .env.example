# ==============================================================================
# QueryPilot Environment Configuration
# Copy this file to .env and populate with your local values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Observability (LangSmith)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=query-pilot

# ------------------------------------------------------------------------------
# Database Configuration (MSSQL / Local SQL Server Express)
# ------------------------------------------------------------------------------
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=GradeSense_Local
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_USE_TRUSTED_CONNECTION=true

# Dedicated Read-Only SQL User (Optional, if not using Trusted Connection)
DB_USER=
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Execution & Safety Guardrails
# ------------------------------------------------------------------------------
DB_QUERY_TIMEOUT_SECONDS=15
DB_MAX_ROW_LIMIT=100

# ------------------------------------------------------------------------------
# API & CORS Settings (Optional)
# ------------------------------------------------------------------------------
# Comma-separated list or JSON array of allowed origins for cross-origin deployments.
# Leave empty for same-origin or local reverse proxy deployments (CORS disabled by default).
# Wildcards ('*'), paths, queries, and credentials are strictly rejected for security.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://querypilot.example.com
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# Prototype Security & Abuse Protection (Task 1.34-B1-F14)
# ------------------------------------------------------------------------------
# Force SQL-only mode server-side. When true, all requests are processed in SQL-only
# mode using the in-memory demo schema, preventing any database connection attempts.
QUERY_PILOT_FORCE_SQL_ONLY=false

# Shared prototype access key for private evaluation. If configured, clients must provide
# this key in the X-QueryPilot-Access-Key request header to execute /query calls.
# Leave unset or empty for unauthenticated local development / testing.
QUERY_PILOT_ACCESS_KEY=

# Fail-closed startup enforcement. When true, the application fails startup validation
# if QUERY_PILOT_ACCESS_KEY is empty or missing, preventing unprotected public deployment.
QUERY_PILOT_REQUIRE_ACCESS_KEY=false

# Maximum allowed request body size in bytes for POST /query (default: 65536 = 64 KB).
QUERY_PILOT_MAX_REQUEST_BYTES=65536

# Maximum requests per minute allowed on /query across the prototype (default: 20 RPM).
QUERY_PILOT_RATE_LIMIT_PER_MINUTE=20

# Maximum concurrent active queries executing on /query (default: 3).
QUERY_PILOT_MAX_CONCURRENT_QUERIES=3
